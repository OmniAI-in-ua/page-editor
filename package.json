{
  "name": "@omniai/page-editor",
  "version": "0.1.0",
  "description": "Ядро редактора сторінки манги: стан правки, розкладка тексту, малювання (браузер і сервер), історія",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "browser": ["./dist/browser.d.ts"],
      "node": ["./dist/node.d.ts"],
      "vue": ["./dist/vue.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hyphenation.uk": "^0.2.1",
    "hypher": "^0.2.5"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.50",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.13"
  }
}
